}

.book-button {
    background: linear-gradient(135deg, #806247, #634a35);
    color: #ffffff;
    box-shadow: 0 9px 22px rgba(99, 74, 53, 0.22);
}

.book-button:hover {
    background: linear-gradient(135deg, #70543d, #513a29);
    color: #ffffff;
    box-shadow: 0 12px 26px rgba(99, 74, 53, 0.28);
}

