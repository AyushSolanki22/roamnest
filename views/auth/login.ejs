<%- include('../partials/head') %>
  </head>

  <body class="min-h-screen bg-[#f8f5f0] text-slate-800">
    <%- include('../partials/header') %>

    <div class="mx-auto max-w-xl px-4 py-8 sm:px-6 lg:py-10">

      <%- include('../partials/errors') %>

      <div class="rounded-[18px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <h1 class="mb-8 text-center text-4xl font-bold text-slate-900">Login with your RoamNest account</h1>

        <form action="/login" method="POST" class="space-y-5">
          <div>
            <label for="username" class="mb-2 block text-sm font-medium text-slate-700">Email</label>
            <div class="flex items-center rounded-lg border border-slate-300 bg-[#fcfaf7] px-3 focus-within:border-[#806047] focus-within:ring-2 focus-within:ring-[#806047]/15">
              <span class="mr-2 text-slate-500">👤</span>
              <input
                id="username"
                class="w-full bg-transparent py-3 text-slate-800 outline-none placeholder:text-slate-400"
                type="email"
                name="email"
                placeholder="Enter your Email"
                value="<%= oldInput.email ? oldInput.email: ''%>"
                required
              >
            </div>
          </div>

          <div>
            <label for="password" class="mb-2 block text-sm font-medium text-slate-700">Password</label>
            <div class="flex items-center rounded-lg border border-slate-300 bg-[#fcfaf7] px-3 focus-within:border-[#806047] focus-within:ring-2 focus-within:ring-[#806047]/15">
              <span class="mr-2 text-slate-500">🔒</span>
              <input
                id="password"
                class="w-full bg-transparent py-3 text-slate-800 outline-none placeholder:text-slate-400"
                type="password"
                name="password"
                placeholder="Enter your Password"
                required
              >
            </div>
          </div>

          <button
  type="submit"
  style="background-color: #806047; color: #ffffff;"
  class="flex w-full items-center justify-center rounded-xl px-4 py-3 text-lg font-bold shadow-md transition hover:opacity-90"
>
  <span class="mr-2">Sign In</span>
  <span aria-hidden="true">→</span>
</button>
        </form>
      </div>
    </div>
  </body>
</html>