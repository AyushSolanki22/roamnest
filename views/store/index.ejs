<%- include("../partials/head") %>
<body class="rn-body">
  <%- include("../partials/header") %>
  <main class="rn-page-shell rn-homepage">
    <section class="rn-hero">
      <div class="rn-hero-content">
        <p class="rn-eyebrow">Make room for a little wonder</p>
        <h1>Stay somewhere<br /><span>that stays with you.</span></h1>
        <p>Discover thoughtful stays for spontaneous weekends, meaningful moments, and slower ways to travel.</p>
        <a class="rn-button rn-button-primary" href="/homes">Explore all stays <span aria-hidden="true">→</span></a>
      </div>
      <div class="rn-hero-art" role="img" aria-label="Warm, inviting travel-inspired landscape illustration">
        <div class="rn-art-sun"></div><div class="rn-art-hill rn-art-hill-back"></div><div class="rn-art-hill rn-art-hill-front"></div><div class="rn-art-house"><span></span></div>
        <p>Find your own kind of getaway.</p>
      </div>
    </section>

    <section class="rn-results-section rn-featured-section">
      <div class="rn-results-heading">
        <div><p class="rn-eyebrow">A few places to begin</p><h2>Stays to fall for</h2></div>
        <a class="rn-details-link" href="/homes">Explore all stays <span aria-hidden="true">→</span></a>
      </div>
      <% if (registeredHomes.length === 0) { %>
        <div class="rn-empty-state"><h3>Your next stay starts here</h3><p>New properties will appear here as hosts add their listings.</p><a class="rn-button rn-button-secondary" href="/homes">Explore stays</a></div>
      <% } else { %>
        <div class="rn-property-grid">
          <% registeredHomes.slice(0, 3).forEach(home => { %>
            <article class="rn-property-card">
              <a class="rn-property-image-link" href="/homes/<%= home._id %>" aria-label="View <%= home.name %>"><img src="<%= home.photo %>" alt="<%= home.name %>" class="rn-property-image" loading="lazy" /><span class="rn-image-tag">Featured stay</span></a>
              <div class="rn-property-content">
                <div class="rn-property-title-row"><div><p class="rn-property-location">⌖ <%= home.location %></p><h3><a href="/homes/<%= home._id %>"><%= home.name %></a></h3></div><span class="rn-rating">★ <%= Number(home.rating).toFixed(1) %></span></div>
                <div class="rn-property-meta"><span>Up to <%= home.maxGuests %> guests</span></div>
                <div class="rn-property-footer"><p class="rn-price"><strong>₹<%= Number(home.price).toLocaleString('en-IN') %></strong><span> / night</span></p><a class="rn-details-link" href="/homes/<%= home._id %>">View stay ↗</a></div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
