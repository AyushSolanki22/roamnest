    color: #29251f;
}

.price-night {
    color: #81776c;
}

.available-badge {
    background: #e8f4e9;
    color: #367348;
    border-color: #cde4d0;
}

.section-heading {
    color: #29251f;
}

.info-card.location,
.info-card.rating,
.info-card.stay {
    background: #faf8f5;
    border-color: #e8e0d7;
}

.location .info-label,
.rating .info-label,
.stay .info-label {
    color: #806247;
}

.info-value {
    color: #29251f;
}

.favourite-button {
    background: #ffffff;
    color: #634a35;
    border-color: #d9c7b5;
}

.favourite-button:hover {
    background: #f2e9df;
