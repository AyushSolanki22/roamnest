<%- include('../partials/head') %>


<style>
    * {
        box-sizing: border-box;
    }

    :root {
        --rn-cream: #f8f6f2;
        --rn-surface: #ffffff;
        --rn-brown: #806247;
        --rn-brown-dark: #634a35;
        --rn-brown-light: #f2e9df;
        --rn-border: #e8e0d7;
        --rn-text: #29251f;
        --rn-muted: #81776c;
        --rn-green-bg: #e8f4e9;
        --rn-green-text: #367348;
        --rn-red-bg: #f8e8e4;
        --rn-red-text: #a4493d;
        --rn-shadow: 0 12px 34px rgba(65, 48, 31, 0.07);
    }

    body {
        margin: 0;
        background: var(--rn-cream);
        color: var(--rn-text);
        font-family: inherit;
        -webkit-font-smoothing: antialiased;
    }

    .bookings-page {
        max-width: 1240px;
        margin: 0 auto;
        padding: 44px 28px 76px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 32px;
    }

    .header-small {
        color: var(--rn-brown);
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.8px;
        margin-bottom: 9px;
    }

    .page-title {
        margin: 0;
        color: var(--rn-text);
        font-size: clamp(30px, 3.5vw, 40px);
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -1.1px;
    }

    .page-subtitle {
        margin: 11px 0 0;
        color: var(--rn-muted);
        font-size: 15px;
        line-height: 1.7;
    }

    .booking-count {
        background: var(--rn-brown-light);
        color: var(--rn-brown-dark);
        border: 1px solid #e5d4c3;
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 750;
        white-space: nowrap;
    }

    .empty-bookings {
        background: var(--rn-surface);
        border: 1px solid var(--rn-border);
        border-radius: 22px;
        padding: 72px 30px;
        text-align: center;
        box-shadow: var(--rn-shadow);
    }

    .empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 22px;
        border-radius: 22px;
        background: var(--rn-brown-light);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
    }

    .empty-bookings h2 {
        margin: 0;
        color: var(--rn-text);
        font-size: 25px;
        font-weight: 800;
        letter-spacing: -0.4px;
    }

    .empty-bookings p {
        color: var(--rn-muted);
        margin: 12px 0 26px;
        line-height: 1.7;
    }

    .explore-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        background: var(--rn-brown);
        color: #ffffff;
        padding: 13px 23px;
        border: 1px solid var(--rn-brown);
        border-radius: 11px;
        font-weight: 750;
        font-size: 14px;
        transition: background 0.2s ease, transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .explore-button:hover {
        background: var(--rn-brown-dark);
        border-color: var(--rn-brown-dark);
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(99, 74, 53, 0.18);
    }

    .booking-list {
        display: flex;
        flex-direction: column;
        gap: 26px;
    }

    .booking-card {
        background: var(--rn-surface);
        border: 1px solid var(--rn-border);
        border-radius: 21px;
        overflow: hidden;
        display: grid;
        grid-template-columns: minmax(250px, 31%) minmax(0, 1fr);
        box-shadow: var(--rn-shadow);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .booking-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 42px rgba(65, 48, 31, 0.11);
    }

    .booking-image-container {
        position: relative;
        min-height: 330px;
        background: #e9e1d7;
        overflow: hidden;
    }

    .booking-image {
        width: 100%;
        height: 100%;
        min-height: 330px;
        object-fit: cover;
        display: block;
        transition: transform 0.45s ease;
    }

    .booking-card:hover .booking-image {
        transform: scale(1.025);
    }

    .status-badge {
        position: absolute;
        top: 16px;
        left: 16px;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 800;
        backdrop-filter: blur(10px);
        z-index: 1;
        letter-spacing: 0.1px;
    }

    .status-confirmed {
        background: rgba(232, 244, 233, 0.96);
        color: var(--rn-green-text);
        border: 1px solid #cde4d0;
    }

    .status-cancelled {
        background: rgba(248, 232, 228, 0.96);
        color: var(--rn-red-text);
        border: 1px solid #ecd0c9;
    }

    .booking-content {
        padding: 28px 30px;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .booking-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 22px;
    }

    .property-label {
        color: var(--rn-brown);
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
    }

    .property-name {
        margin: 0;
        color: var(--rn-text);
        font-size: clamp(22px, 2.2vw, 28px);
        line-height: 1.25;
        font-weight: 800;
        letter-spacing: -0.6px;
        overflow-wrap: anywhere;
    }

    .property-location {
        margin-top: 9px;
        color: var(--rn-muted);
        font-size: 13px;
        line-height: 1.6;
    }

    .total-price {
                    text-align: right;
        flex-shrink: 0;
        white-space: nowrap;
    }

    .total-label {
        color: #9b9084;
        font-size: 11px;
        margin-bottom: 5px;
    }

    .total-value {
        color: var(--rn-text);
        font-size: clamp(20px, 2vw, 25px);
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .booking-divider {
        height: 1px;
        background: var(--rn-border);
        margin: 23px 0 20px;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 11px;
    }

    .detail-box {
        background: #faf8f5;
        border: 1px solid #ece5dd;
        border-radius: 13px;
        padding: 14px 13px;
        min-width: 0;
        transition: border-color 0.2s ease, background 0.2s ease;
    }

    .detail-box:hover {
        background: #f7f1e9;
        border-color: #e0d0bf;
    }

    .detail-icon {
        font-size: 17px;
        margin-bottom: 9px;
    }

    .detail-label {
        color: #968a7d;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    .detail-value {
        color: var(--rn-text);
        font-size: 13px;
        font-weight: 750;
        line-height: 1.5;
        margin-top: 5px;
        overflow-wrap: anywhere;
    }

    .booking-info {
        margin-top: 16px;
        background: #faf6f1;
        border: 1px solid #eee2d5;
        border-radius: 14px;
        padding: 16px;
        color: var(--rn-muted);
        font-size: 12px;
        line-height: 1.55;
    }

    .booking-info strong {
        color: #504438;
    }

    .price-breakdown-title {
        font-weight: 800;
        color: var(--rn-text);
        font-size: 13px;
        margin-bottom: 13px;
    }

    .price-breakdown-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 10px;
    }

    .price-breakdown-row span {
        min-width: 0;
    }

    .price-breakdown-row strong {
        white-space: nowrap;
        text-align: right;
        color: #51463b;
    }

    .price-breakdown-total {
        border-top: 1px solid #e4d4c4;
        padding-top: 13px;
        margin-top: 13px;
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 16px;
        font-size: 14px;
    }

    .price-breakdown-total strong:first-child {
        color: var(--rn-text);
    }

    .price-breakdown-total strong:last-child {
        color: var(--rn-brown-dark);
        white-space: nowrap;
        font-size: 15px;
    }

    .booking-actions {
        margin-top: auto;
        padding-top: 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .view-property {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: var(--rn-brown-dark);
        border: 1px solid #d9c7b5;
        background: #ffffff;
        padding: 11px 17px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 750;
        transition: background 0.2s ease, border-color 0.2s ease,
            transform 0.2s ease;
    }

    .view-property:hover {
        background: var(--rn-brown-light);
        border-color: #c9ad94;
        color: var(--rn-brown-dark);
        transform: translateY(-1px);
    }

    .cancel-button {
        border: 1px solid #ead1ca;
        background: var(--rn-red-bg);
        color: var(--rn-red-text);
        padding: 11px 17px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 750;
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease;
    }

    .cancel-button:hover {
        background: #f2d9d3;
        border-color: #dfb9af;
    }

    .cancelled-message {
        color: #92877b;
        font-size: 12px;
        font-weight: 650;
        line-height: 1.6;
    }

    .view-property:focus-visible,
    .explore-button:focus-visible,
    .cancel-button:focus-visible {
        outline: 3px solid #c5a78b;
        outline-offset: 3px;
    }

    @media (max-width: 1000px) {
        .booking-card {
            grid-template-columns: minmax(220px, 30%) minmax(0, 1fr);
        }

        .booking-content {
            padding: 24px;
        }

        .booking-top {
            gap: 14px;
        }

        .details-grid {
            gap: 8px;
        }

        .detail-box {
            padding: 12px 10px;
        }
    }

    @media (max-width: 850px) {
        .booking-card {
            grid-template-columns: 1fr;
        }

        .booking-image-container {
            min-height: 270px;
            max-height: 340px;
        }

        .booking-image {
            min-height: 270px;
            max-height: 340px;
        }

        .booking-content {
            padding: 25px;
        }
    }

    @media (max-width: 650px) {
        .bookings-page {
            padding: 30px 15px 48px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 32px;
        }

        .page-subtitle {
            font-size: 14px;
                    }

        .booking-count {
            padding: 9px 13px;
        }

        .booking-list {
            gap: 20px;
        }

        .booking-card {
            border-radius: 17px;
        }

        .booking-image-container {
            min-height: 235px;
            max-height: 270px;
        }

        .booking-image {
            min-height: 235px;
            max-height: 270px;
        }

        .booking-content {
            padding: 20px 17px;
        }

        .booking-top {
            flex-direction: column;
            gap: 15px;
        }

        .total-price {
            text-align: left;
        }

        .total-value {
            font-size: 23px;
        }

        .booking-divider {
            margin: 19px 0;
        }

        .details-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 7px;
        }

        .detail-box {
            padding: 11px 8px;
            border-radius: 10px;
        }

        .detail-icon {
            font-size: 15px;
        }

        .detail-label {
            font-size: 9px;
            letter-spacing: 0.4px;
        }

        .detail-value {
            font-size: 12px;
        }

        .booking-info {
            padding: 13px;
        }

        .price-breakdown-row,
        .price-breakdown-total {
            gap: 10px;
        }

        .price-breakdown-total {
            font-size: 13px;
        }

        .price-breakdown-total strong:last-child {
            font-size: 14px;
        }

        .booking-actions {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
        }

        .view-property,
        .cancel-button {
            width: 100%;
            min-height: 43px;
            text-align: center;
        }

        .booking-actions form {
            width: 100%;
        }

        .cancelled-message {
            text-align: center;
        }

        .empty-bookings {
            padding: 52px 20px;
            border-radius: 18px;
        }
    }

    @media (max-width: 380px) {
        .details-grid {
            grid-template-columns: 1fr;
        }

        .detail-box {
            display: grid;
            grid-template-columns: 28px 1fr;
            column-gap: 8px;
            align-items: center;
        }

        .detail-icon {
            grid-row: span 2;
            margin: 0;
        }

        .detail-label,
        .detail-value {
            margin-top: 0;
        }

        .price-breakdown-row,
        .price-breakdown-total {
            font-size: 11px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .booking-card,
        .booking-image,
        .explore-button,
        .view-property,
        .cancel-button {
            transition: none;
        }

        .booking-card:hover,
        .booking-card:hover .booking-image,
        .explore-button:hover,
        .view-property:hover {
            transform: none;
        }
    }
</style>


</head>

<body>
    <%- include('../partials/header') %>

    <main class="bookings-page">
        <!-- PAGE HEADER -->
        <div class="page-header">
            <div>
                <div class="header-small">Your stays</div>

                <h1 class="page-title">My Bookings</h1>

                <p class="page-subtitle">
                    View and manage all your upcoming and previous stays.
                </p>
            </div>

            <div class="booking-count">
                <%= (bookings || []).length %>
                <%= (bookings || []).length === 1 ? "Booking" : "Bookings" %>
            </div>
        </div>

        <% if (earlyCheckoutError) { %>
  <div
    role="alert"
    style="
      margin-bottom: 24px;
      padding: 16px 18px;
      border: 1px solid #ecd0c9;
      border-radius: 12px;
      background: #f8e8e4;
      color: #a4493d;
      line-height: 1.6;
    "
  >
    <strong>Unable to submit early checkout</strong>
    <p style="margin: 5px 0 0;">
      <%= earlyCheckoutError %>
    </p>
  </div>
<% } %>

        <!-- NO BOOKINGS -->
        <% if (!bookings || bookings.length === 0) { %>
            <div class="empty-bookings">
                <div class="empty-icon">🏡</div>

                <h2>No bookings yet</h2>

                <p>
                    You haven't reserved a stay yet.
                    Find a home and start planning your next trip.
                </p>

                <a href="/homes" class="explore-button">
                    Explore Homes
                </a>
            </div>
        <% } else { %>

            <!-- BOOKINGS -->
            <div class="booking-list">
                <% bookings.forEach(booking => { %>
                    <%
                        // Use saved booking values for historical prices.
                        // The home's current price may have changed since booking.

                        // Explicitly check missing values before Number conversion:
                        // Number(null) and Number("") both evaluate to zero.
                        const savedNightlyPrice =
                            booking.basePrice !== null &&
                            booking.basePrice !== undefined &&
                            booking.basePrice !== "" &&
                            Number.isFinite(Number(booking.basePrice)) &&
                            Number(booking.basePrice) >= 0
                                ? Number(booking.basePrice)
                                : null;

                        const savedBaseAmount =
                            booking.baseAmount !== null &&
                            booking.baseAmount !== undefined &&
                            booking.baseAmount !== "" &&
                            Number.isFinite(Number(booking.baseAmount)) &&
                            Number(booking.baseAmount) >= 0
                                ? Number(booking.baseAmount)
                                : null;

                        const savedExtraGuestAmount =
                            booking.extraGuestAmount !== null &&
                            booking.extraGuestAmount !== undefined &&
                            booking.extraGuestAmount !== "" &&
                            Number.isFinite(Number(booking.extraGuestAmount)) &&
                            Number(booking.extraGuestAmount) >= 0
                                ? Number(booking.extraGuestAmount)
                                : null;

                        const savedTotalPrice =
                            booking.totalPrice !== null &&
                            booking.totalPrice !== undefined &&
                            booking.totalPrice !== "" &&
                            Number.isFinite(Number(booking.totalPrice)) &&
                            Number(booking.totalPrice) >= 0
                                ? Number(booking.totalPrice)
                                : null;

                        const savedExtraGuestFee =
                            booking.extraGuestFee !== null &&
                            booking.extraGuestFee !== undefined &&
                            booking.extraGuestFee !== "" &&                             Number.isFinite(Number(booking.extraGuestFee)) &&
                            Number(booking.extraGuestFee) >= 0
                                ? Number(booking.extraGuestFee)
                                : null;

                        const savedIncludedGuests =
                            booking.includedGuests !== null &&
                            booking.includedGuests !== undefined &&
                            booking.includedGuests !== "" &&
                            Number.isInteger(Number(booking.includedGuests)) &&
                            Number(booking.includedGuests) >= 1
                                ? Number(booking.includedGuests)
                                : null;

                        const savedExtraGuests =
                            booking.extraGuests !== null &&
                            booking.extraGuests !== undefined &&
                            booking.extraGuests !== "" &&
                            Number.isInteger(Number(booking.extraGuests)) &&
                            Number(booking.extraGuests) >= 0
                                ? Number(booking.extraGuests)
                                : null;

                        const formatINR = (amount) => {
                            const safeAmount = Number(amount);

                            return Number.isFinite(safeAmount) && safeAmount >= 0
                                ? safeAmount.toLocaleString("en-IN", {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                })
                                : "Not available";
                        };

                        const formatDate = (value) => {
                            const date = new Date(value);

                            return !Number.isNaN(date.getTime())
                                ? date.toLocaleDateString("en-IN", {
                                    day: "numeric",
                                    month: "short",
                                    year: "numeric"
                                })
                                : "Not available";
                        };

                                                const formatDateInput = (value) => {
                            const date = new Date(value);

                            if (Number.isNaN(date.getTime())) {
                                return "";
                            }

                            return [
                                date.getFullYear(),
                                String(date.getMonth() + 1).padStart(2, "0"),
                                String(date.getDate()).padStart(2, "0")
                            ].join("-");
                        };

                        const getPreviousDateInput = (value) => {
                            const date = new Date(value);

                            if (Number.isNaN(date.getTime())) {
                                return "";
                            }

                            date.setDate(date.getDate() - 1);

                            return formatDateInput(date);
                        };
                    %>

                    <% if (!booking.home) { %>
                        <!-- PROPERTY DELETED: KEEP HISTORICAL BOOKING VISIBLE -->
                        <article class="booking-card">
                            <div
                                class="booking-image-container"
                                style="display:flex;align-items:center;justify-content:center;padding:24px;"
                            >
                                <% if (booking.status === "confirmed") { %>
                                    <div class="status-badge status-confirmed">
                                        ✓ Confirmed
                                    </div>
                                <% } else { %>
                                    <div class="status-badge status-cancelled">
                                        ✕ Cancelled
                                    </div>
                                <% } %>

                                <div style="font-size:56px;" aria-hidden="true">🏡</div>
                            </div>

                            <div class="booking-content">
                                <div class="booking-top">
                                    <div>
                                        <div class="property-label">Booking history</div>

                                        <h2 class="property-name">
                                            This property is no longer available
                                        </h2>

                                        <div class="property-location">
                                            The property may have been removed by its host.
                                        </div>
                                    </div>

                                    <div class="total-price">
                                        <div class="total-label">Total booking price</div>

                                        <div class="total-value">
                                            ₹<%= savedTotalPrice !== null
                                                ? formatINR(savedTotalPrice)
                                                : "Not available" %>
                                        </div>
                                    </div>
                                </div>

                                <div class="booking-divider"></div>

                                <div class="details-grid">
                                    <div class="detail-box">
                                        <div class="detail-icon">🗓️</div>
                                        <div class="detail-label">Check-in</div>

                                        <div class="detail-value">
                                            <%= formatDate(booking.checkIn) %>
                                        </div>
                                    </div>

                                    <div class="detail-box">
                                        <div class="detail-icon">🗓️</div>
                                        <div class="detail-label">Check-out</div>

                                        <div class="detail-value">
                                            <%= formatDate(booking.checkOut) %>
                                        </div>
                                    </div>

                                    <div class="detail-box">
                                        <div class="detail-icon">👥</div>
                                        <div class="detail-label">Guests</div>

                                        <div class="detail-value">
                                            <%= booking.guests %>
                                            <%= Number(booking.guests) === 1 ? "Guest" : "Guests" %>
                                        </div>
                                    </div>
                                </div>

                                <div class="booking-info">
                                    <div class="price-breakdown-title">
                                        Saved price breakdown
                                    </div>

                                    <div class="price-breakdown-row">
                                        <span>
                                            Nightly rate × <%= booking.nights %>
                                            <%= Number(booking.nights) === 1 ? "night" : "nights" %>
                                        </span>

                                        <strong>
                                            <% if (savedNightlyPrice !== null) { %>
                                                ₹<%= formatINR(savedNightlyPrice) %>
                                            <% } else { %>
                                                Historical rate unavailable
                                            <% } %>
                                        </strong>
                                    </div>

                                    <div class="price-breakdown-row">
                                        <span>Guests included in base price</span>
                                        <strong>
                                            <%= savedIncludedGuests !== null
                                                ? savedIncludedGuests
                                                : "Not recorded" %>
                                        </strong>
                                    </div>

                                    <div class="price-breakdown-row">
                                        <span>Accommodation subtotal</span>
                                        <strong>
                                            <%= savedBaseAmount !== null
                                                ? "₹" + formatINR(savedBaseAmount)
                                                : "Not available" %>
                                        </strong>
                                    </div>

                                    <div class="price-breakdown-row">
                                        <span>
                                            Extra guest charges
                                            <% if (savedExtraGuests !== null && savedExtraGuests > 0) { %>
                                                (<%= savedExtraGuests %> extra
                                                <%= savedExtraGuests === 1 ? "guest" : "guests" %>)
                                            <% } %>
                                        </span>

                                        <strong>
                                            <%= savedExtraGuestAmount !== null
                                                ? "₹" + formatINR(savedExtraGuestAmount)
                                                : "Not available" %>
                                        </strong>
                                    </div>

                                    <div class="price-breakdown-row">
                                        <span>Extra guest fee per night</span>
                                        <strong>
                                            <%= savedExtraGuestFee !== null
                                                ? "₹" + formatINR(savedExtraGuestFee)
                                                : "Not recorded" %>
                                        </strong>
                                    </div>

                                    <div class="price-breakdown-total">
                                        <strong>Total booking price</strong>
                                        <strong>
                                            <%= savedTotalPrice !== null
                                                ? "₹" + formatINR(savedTotalPrice)
                                                : "Not available" %>
                                        </strong>
                                    </div>

                                    <p style="margin:12px 0 0;">
                                        The property has been removed, but the saved booking details remain available.
                                        Historical fields that were not recorded when the booking was created cannot
                                        be reconstructed reliably.
                                    </p>
                                </div>

                                <div class="booking-actions">
                                    <% if (booking.status === "confirmed") { %>
                                        <span class="cancelled-message">
                                            Contact support if you need help with this booking.
                                        </span>
                                    <% } else { %>
                                        <span class="cancelled-message">
                                            This booking has been cancelled.
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </article>

                    <% } else { %>
                        <!-- PROPERTY STILL EXISTS -->                        <article class="booking-card">
                            <!-- PROPERTY IMAGE -->
                            <div class="booking-image-container">
                                <% if (booking.status === "confirmed") { %>
                                    <div class="status-badge status-confirmed">
                                        ✓ Confirmed
                                    </div>
                                <% } else { %>
                                    <div class="status-badge status-cancelled">
                                        ✕ Cancelled
                                    </div>
                                <% } %>

                                <img
                                    src="<%= booking.home.photo %>"
                                    alt="<%= booking.home.name %>"
                                    class="booking-image"
                                >
                            </div>

                            <!-- BOOKING CONTENT -->
                            <div class="booking-content">
                                <div class="booking-top">
                                    <div>
                                        <div class="property-label">Your stay</div>

                                        <h2 class="property-name">
                                            <%= booking.home.name %>
                                        </h2>

                                        <div class="property-location">
                                            📍 <%= booking.home.location %>
                                        </div>
                                    </div>

                                    <div class="total-price">
                                        <div class="total-label">Total booking price</div>

                                        <div class="total-value">
                                            ₹<%= savedTotalPrice !== null
                                                ? formatINR(savedTotalPrice)
                                                : "Not available" %>
                                        </div>
                                    </div>
                                </div>

                                <div class="booking-divider"></div>

                                <!-- BOOKING DETAILS -->
                                <div class="details-grid">
                                    <div class="detail-box">
                                        <div class="detail-icon">🗓️</div>
                                        <div class="detail-label">Check-in</div>

                                        <div class="detail-value">
                                            <%= formatDate(booking.checkIn) %>
                                        </div>
                                    </div>

                                    <div class="detail-box">
                                        <div class="detail-icon">🗓️</div>
                                        <div class="detail-label">Check-out</div>

                                        <div class="detail-value">
                                            <%= formatDate(booking.checkOut) %>
                                        </div>
                                    </div>

                                    <div class="detail-box">
                                        <div class="detail-icon">👥</div>
                                        <div class="detail-label">Guests</div>

                                        <div class="detail-value">
                                            <%= booking.guests %>
                                            <%= Number(booking.guests) === 1 ? "Guest" : "Guests" %>
                                        </div>
                                    </div>
                                </div>

                                <!-- SAVED PRICE INFORMATION -->
                                <div class="booking-info">
                                    <div class="price-breakdown-title">
                                        Price breakdown
                                    </div>

                                    <div class="price-breakdown-row">
                                        <span>
                                            Nightly rate × <%= booking.nights %>
                                            <%= Number(booking.nights) === 1 ? "night" : "nights" %>
                                        </span>

                                        <strong>
                                            <% if (savedNightlyPrice !== null) { %>
                                                ₹<%= formatINR(savedNightlyPrice) %>
                                            <% } else { %>
                                                Historical rate unavailable
                                            <% } %>
                                        </strong>
                                    </div>

                                    <div class="price-breakdown-row">
                                        <span>Guests included in base price</span>
                                        <strong>
                                            <%= savedIncludedGuests !== null
                                                ? savedIncludedGuests
                                                : "Not recorded" %>
                                        </strong>
                                    </div>

                                    <div class="price-breakdown-row">
                                        <span>Accommodation subtotal</span>
                                        <strong>
                                            <%= savedBaseAmount !== null
                                                ? "₹" + formatINR(savedBaseAmount)
                                                : "Not available" %>
                                        </strong>
                                    </div>

                                    <div class="price-breakdown-row">
                                        <span>
                                            Extra guest charges
                                            <% if (savedExtraGuests !== null && savedExtraGuests > 0) { %>
                                                (<%= savedExtraGuests %> extra
                                                <%= savedExtraGuests === 1 ? "guest" : "guests" %>)
                                            <% } %>
                                        </span>

                                        <strong>
                                            <%= savedExtraGuestAmount !== null
                                                ? "₹" + formatINR(savedExtraGuestAmount)
                                                : "Not available" %>
                                        </strong>
                                    </div>

                                    <div class="price-breakdown-row">
                                        <span>Extra guest fee per night</span>
                                        <strong>
                                            <%= savedExtraGuestFee !== null
                                                ? "₹" + formatINR(savedExtraGuestFee)
                                                : "Not recorded" %>
                                        </strong>
                                    </div>

                                    <!--
                                        Service fee is not currently part of the Booking schema.
                                        Keep this comment for a future intentional service-fee feature.
                                    -->

                                    <div class="price-breakdown-total">
                                        <strong>Total booking price</strong>
                                        <strong>
                                            <%= savedTotalPrice !== null
                                                ? "₹" + formatINR(savedTotalPrice)
                                                : "Not available" %>
                                        </strong>
                                    </div>
                                </div>

                                <%
  const earlyRequest = booking.earlyCheckout || {};
  const earlyRequestStatus = earlyRequest.requestStatus || "none";

  const todayForEarlyCheckout = new Date();
  todayForEarlyCheckout.setHours(0, 0, 0, 0);

  const checkInForEarlyCheckout = new Date(booking.checkIn);
  checkInForEarlyCheckout.setHours(0, 0, 0, 0);

  const checkOutForEarlyCheckout = new Date(booking.checkOut);
  checkOutForEarlyCheckout.setHours(0, 0, 0, 0);

  const canRequestEarlyCheckout =
    booking.status === "confirmed" &&
    todayForEarlyCheckout >= checkInForEarlyCheckout &&
    todayForEarlyCheckout < checkOutForEarlyCheckout &&
    earlyRequestStatus !== "pending" &&
    earlyRequestStatus !== "approved";

  const todayDateInput = [
    todayForEarlyCheckout.getFullYear(),
    String(todayForEarlyCheckout.getMonth() + 1).padStart(2, "0"),
    String(todayForEarlyCheckout.getDate()).padStart(2, "0")
  ].join("-");
%>

<% if (booking.status === "confirmed") { %>
  <section class="booking-info">
    <h3>Early checkout</h3>

    <% if (earlyRequestStatus === "pending") { %>
      <p>Your early-checkout request is awaiting the host's decision.</p>

    <% } else if (earlyRequestStatus === "approved") { %>
      <p>
        Your early checkout was approved.
        New checkout:
        <strong><%= formatDate(booking.checkOut) %></strong>
      </p>

      <p>
        Approved refund:
        <strong>
          ₹<%= formatINR(earlyRequest.approvedRefund || 0) %>
        </strong>
      </p>

      <% if (earlyRequest.refundStatus === "approved_pending_payment") { %>
        <p>The refund has been approved but payment processing is still pending.</p>
      <% } else if (earlyRequest.refundStatus === "refunded") { %>
        <p>Your refund has been marked as completed.</p>
      <% } %>

    <% } else if (earlyRequestStatus === "rejected") { %>
      <p>The host rejected your previous request. You may submit a new request.</p>

    <% } %>

    <% if (canRequestEarlyCheckout) { %>
      <form
        action="/bookings/<%= booking._id %>/early-checkout"
        method="POST"
        style="margin-top:14px;"
      >
        <label for="early-date-<%= booking._id %>">
          Requested checkout date
        </label>

        <input
          id="early-date-<%= booking._id %>"
          type="date"
          name="requestedCheckOut"
          min="<%= todayDateInput %>"
          max="<%= getPreviousDateInput(booking.checkOut) %>"
          required
          style="display:block;width:100%;max-width:320px;padding:10px;margin:8px 0 14px;"
        />

        <label for="early-reason-<%= booking._id %>">
          Reason for early checkout
        </label>

        <textarea
          id="early-reason-<%= booking._id %>"
          name="reason"
          maxlength="1000"
          required
          rows="3"
          placeholder="Tell your host why you need to leave early."
          style="display:block;width:100%;padding:10px;margin:8px 0 14px;"
        ></textarea>
                <p>
          Your host must approve the request before your booking dates change.
          Any refund is subject to the host's decision.
        </p>

        <button type="submit" class="cancel-button">
          Request early checkout
        </button>
      </form>
    <% } %>
  </section>
<% } %>

                                <!-- ACTIONS -->
                                <div class="booking-actions">
                                    <a
                                        href="/homes/<%= booking.home._id %>"
                                        class="view-property"
                                    >
                                        View Property →
                                    </a>

                                    <% if (
                                        booking.status === "confirmed" &&
                                        booking.checkIn &&
                                        new Date(booking.checkIn).getTime() > Date.now()
                                    ) { %>
                                        <form
                                            action="/cancel-booking/<%= booking._id %>"
                                            method="POST"
                                        >
                                            <button
                                                type="submit"
                                                class="cancel-button"
                                                onclick="return confirm('Are you sure you want to cancel this booking?');"
                                            >
                                                Cancel Booking
                                            </button>
                                        </form>
                                    <% } else if (booking.status === "confirmed") { %>
                                        <span class="cancelled-message">
                                            Cancellation is no longer available after check-in begins.
                                        </span>
                                    <% } else { %>
                                        <span class="cancelled-message">
                                            This booking has been cancelled.
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </article>
                    <% } %>
                <% }) %>
            </div>
        <% } %>
    </main>
</body>
</html>