}

.back-link:focus-visible,
.favourite-button:focus-visible,
.book-button:focus-visible,
.download-button:focus-visible {
    outline: 3px solid #c9ad94;
    outline-offset: 3px;
}


/* =========================
   REVIEWS & RATINGS
========================= */

.reviews-section {
    margin-top: 35px;
    padding: 30px;
    background: #fff;
    border: 1px solid #e8e0d7;
    border-radius: 24px;
    box-shadow: 0 18px 45px rgba(65, 48, 31, 0.06);
}

.reviews-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 24px;
}

.reviews-title {
    margin: 0;
    color: #29251f;
    font-size: 26px;
    font-weight: 850;
}

.reviews-summary {
    margin-top: 7px;
    color: #81776c;
    font-size: 14px;
}

.review-form-card {
    margin-bottom: 28px;
    padding: 24px;
    background: #faf8f5;
    border: 1px solid #e8e0d7;
    border-radius: 18px;
}

.review-form-card h3 {
    margin: 0 0 8px;
    color: #29251f;
    font-size: 19px;
    font-weight: 800;
}

.review-help {
    margin: 0 0 18px;
    color: #81776c;
    font-size: 13px;
    line-height: 1.6;
}

.review-label {
    display: block;
    margin: 16px 0 8px;
    color: #45372b;
    font-size: 13px;
    font-weight: 800;
}

.review-stars-input {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 5px;
}

.review-stars-input input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
}

.review-stars-input label {
    color: #d6cec4;
    cursor: pointer;
    font-size: 32px;
    line-height: 1;
}

.review-stars-input label:hover,
.review-stars-input label:hover ~ label,
.review-stars-input input:checked ~ label {
    color: #c58a32;
}

.review-stars-input input:focus-visible + label {
    outline: 2px solid #806247;
    outline-offset: 3px;
    border-radius: 4px;
}

.review-textarea {
    box-sizing: border-box;
    width: 100%;
    min-height: 125px;
    resize: vertical;
    padding: 13px 14px;
    color: #29251f;
    background: #fff;
    border: 1px solid #d9c7b5;
    border-radius: 12px;
    font: inherit;
    font-size: 14px;
}

.review-textarea:focus {
    outline: 2px solid #c9ad94;
    outline-offset: 2px;
}

.review-submit {
    margin-top: 16px;
    padding: 13px 20px;
    border: 0;
    border-radius: 12px;
    background: #806247;
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
}

.review-submit:hover {
    background: #634a35;
    transform: translateY(-1px);
}

.review-alert {
    margin-bottom: 20px;
    padding: 13px 15px;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.6;
}

.review-alert.success {
    background: #e8f4e9;
    color: #28623a;
    border: 1px solid #cde4d0;
}

.review-alert.error {
    background: #fff3e8;
    color: #8a4b18;
    border: 1px solid #ead1b8;
}

.review-list {
    display: grid;
    gap: 16px;
}

.review-card {
    padding: 20px;
    border: 1px solid #eee7df;
    border-radius: 16px;
    background: #fff;
}

.review-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
}

.review-author {
    color: #29251f;
    font-size: 15px;
    font-weight: 800;
}

.review-date {
    margin-top: 5px;
    color: #81776c;
    font-size: 12px;
}

.review-card-rating {
    color: #a56e20;
    font-size: 14px;
    font-weight: 800;
    white-space: nowrap;
}

.review-comment {
    margin: 15px 0 0;
    color: #655b50;
    font-size: 14px;
    line-height: 1.8;
    overflow-wrap: anywhere;
}

.reviews-empty {
    padding: 24px;
    border: 1px dashed #d9c7b5;
    border-radius: 16px;
    color: #81776c;
    text-align: center;
    line-height: 1.7;
}

@media (max-width: 640px) {
    .reviews-section {
        padding: 20px;
    }

    .review-form-card {
        padding: 18px;
    }

    .reviews-title {
        font-size: 23px;
    }

    .review-card-header {
        flex-direction: column;
    }
}



</style>


</head>


<body>


    <%- include('../partials/header') %>


    <main class="details-page">

        <div class="details-container">


            <!-- =========================
                 BACK
            ========================== -->

            <a href="/homes" class="back-link">

                <span>←</span>

                Back to Homes

            </a>



            <!-- =========================
                 PROPERTY CARD
            ========================== -->

            <section class="property-card">


                <!-- =========================
                     IMAGE
                ========================== -->

                <div class="property-image-wrapper">


                    <img
                        src="<%= home.photo %>"
                        alt="<%= home.name %>"
                        class="property-image"
                    >


                    <div class="image-overlay"></div>


                    <!-- Rating -->

                    <div class="image-rating">

                        <span class="image-rating-star">
                            ★
                        </span>

                        <span>
                            <%= home.rating %> / 5
                        </span>

                    </div>


                    <!-- Image bottom -->

                    <div class="image-bottom">

                        <div class="image-bottom-label">
                            Your next stay
                        </div>

                        <h2 class="image-bottom-title">
                            <%= home.name %>
                        </h2>

                        <div class="image-bottom-location">
                            📍 <%= home.location %>
                        </div>

                    </div>

                </div>



                <!-- =========================
                     DETAILS
                ========================== -->

                <div class="property-details">


                    <div class="details-inner">


                        <div class="small-label">
                            A place to feel at home
                        </div>


                        <!-- Name -->

                        <h1 class="property-name">
                            <%= home.name %>
                        </h1>


                        <!-- Location -->

                        <div class="property-location">

                            <span class="location-icon">
                                ●
                            </span>

                            <%= home.location %>

                        </div>



                        <!-- Rating -->

                        <div class="rating-box">

                            <span class="rating-star">
                                ★
                            </span>

                            <div>

                                <div class="rating-number">
                                    <%= home.rating %> / 5
                                </div>

                                <span class="rating-label">
                                    Property rating
                                </span>

                            </div>

                        </div>



                        <div class="details-divider"></div>



                        <!-- =========================
                             PRICE
                        ========================== -->

                        <div class="price-box">

                            <div class="price-header">

                                <div>

                                    <div class="price-label">
                                        Price
                                    </div>

                                    <div class="price">

                                        ₹<%= home.price %>

                                        <span class="price-night">
                                            / night
                                        </span>

                                    </div>

                                </div>


                                <div class="available-badge">
                                    ✓ Available
                                </div>

                            </div>

                        </div>

                        <div class="trueprice-details" style="margin-top:16px;padding:18px;border:1px solid #f1d9df;border-radius:16px;background:#fff7f8;">
                            <div style="font-weight:800;color:#9f1239;margin-bottom:12px;">TruePrice breakdown</div>
                            <div style="display:flex;justify-content:space-between;gap:16px;margin:8px 0;">
                                <span>Nightly base price</span>
                                <strong>₹<%= Number(home.price).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
                            </div>
                            <div style="display:flex;justify-content:space-between;gap:16px;margin:8px 0;">
                                <span>Guests included in base price</span>
                                <strong><%= includedGuests %></strong>
                            </div>
                            <div style="display:flex;justify-content:space-between;gap:16px;margin:8px 0;">
                                <span>Maximum guests</span>
                                <strong><%= home.maxGuests %></strong>
                            </div>
                            <div style="display:flex;justify-content:space-between;gap:16px;margin:8px 0;">
                                <span>Extra guest fee (per extra guest, per night)</span>
                                <strong>₹<%= Number(home.extraGuestFee || 0).toLocaleString("en-IN", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></strong>
                            </div>
                            <p style="font-size:13px;line-height:1.6;color:#6b7280;margin:14px 0 0;">Your final total depends on your check-in and check-out dates and the number of guests. Extra-guest charges apply only to guests above the included allowance. No additional service fee is added unless explicitly configured.</p>
                        </div>


                        <!-- =========================
                             DESCRIPTION
                        ========================== -->

                        <div class="about-section">

                            <div class="section-heading">

                                <div class="heading-icon">
                                    ✦
                                </div>

                                About this place

                            </div>


                            <% if (home.description) { %>

                                <p class="description">
                                    <%= home.description %>
                                </p>

                            <% } else { %>

                                <p class="description">
                                    No description has been provided for this property.
                                </p>

                            <% } %>

                        </div>



                        <!-- =========================
                             INFO CARDS
                        ========================== -->

                        <div class="info-grid">


                            <div class="info-card location">

                                <div class="info-label">
                                    Location
                                </div>

                                <div class="info-value">
                                    <%= home.location %>
                                </div>

                            </div>


                            <div class="info-card rating">

                                <div class="info-label">
                                    Rating
                                </div>

                                <div class="info-value">
                                    ★ <%= home.rating %> / 5
                                </div>

                            </div>


                            <div class="info-card stay">

                                <div class="info-label">
                                    Stay
                                </div>

                                <div class="info-value">
                                    Comfortable
                                </div>

                            </div>


                        </div>



                        <!-- =========================
                             ACTIONS
                        ========================== -->

                        <div class="actions">


                            <!-- Favourite -->

                            <form
                                action="/favourites"
                                method="POST"
                            >

                                <input
                                    type="hidden"
                                    name="id"
                                    value="<%= home._id %>"
                                >

                                <button
                                    type="submit"
                                    class="favourite-button"
                                >

                                    <span class="heart">
                                        ♡
                                    </span>

                                    Add to Favourites

                                </button>

                            </form>



                            <!-- Book -->

                            <a
                                href="/book/<%= home._id %>"
                                class="book-button"
                            >

                                <span>
                                    Book Now
                                </span>

                                <span class="book-arrow">
                                    →
                                </span>

                            </a>


                        </div>


                        <div class="booking-note">
                            Choose your dates and guests after clicking Book Now.
                        </div>


                    </div>


                </div>

            </section>



            <!-- =========================
                 HOUSE RULES
            ========================== -->

            <% if (home.houseRules) { %>

                <section class="rules-section">


                    <!-- Rules header -->

                    <div class="rules-header">


                        <div class="rules-title-wrapper">


                            <div class="rules-icon">
                                📄
                            </div>


                            <div>

                                <h2 class="rules-title">
                                    House Rules
                                </h2>

                                <p class="rules-subtitle">
                                    Please review the rules before booking your stay.
                                </p>

                            </div>


                        </div>



                        <!-- Download -->

                        <a
                            href="<%= home.houseRules %>"
                            target="_blank"
                            rel="noopener noreferrer"
                            download
                            class="download-button"
                        >

                            <span>
                                ↓
                            </span>

                            Download PDF

                        </a>


                    </div>



                    <!-- PDF -->

                    <div class="pdf-container">

                        <iframe
                            src="<%= home.houseRules %>#toolbar=1&view=FitH"
                            title="House Rules PDF"
                            class="pdf-frame"
                        >
                        </iframe>

                    </div>


                </section>


            <% } else { %>


                <!-- =========================
                     NO RULES
                ========================== -->

                <section class="no-rules">


                    <div class="no-rules-content">


                        <div class="no-rules-icon">
                            📄
                        </div>


                        <div>

                            <h2 class="no-rules-title">
                                House Rules
                            </h2>

                            <p class="no-rules-text">
                                No house rules have been uploaded for this property.
                            </p>

                        </div>


                    </div>


                </section>


            <% } %>


        </div>


<!-- =========================
     REVIEWS & RATINGS
========================= -->

<section class="reviews-section" id="reviews">

    <div class="reviews-header">
        <div>
            <h2 class="reviews-title">Guest Reviews</h2>
            <p class="reviews-summary">
                <% if (reviewCount > 0) { %>
                    ★ <%= averageRating.toFixed(1) %> out of 5
                    · <%= reviewCount %>
                    <%= reviewCount === 1 ? "review" : "reviews" %>
                <% } else { %>
                    No guest reviews yet. Be the first to share your experience.
                <% } %>
            </p>
        </div>
    </div>

    <% if (reviewMessage === "success") { %>
    <div class="review-alert success" role="status">
        Your review has been submitted successfully. Thank you!
    </div>
<% } else if (reviewMessage === "duplicate") { %>
    <div class="review-alert error" role="alert">
        This booking has already been reviewed.
    </div>
<% } %>

    <% if (eligibleBooking) { %>
        <div class="review-form-card">
            <h3>How was your stay?</h3>
            <p class="review-help">
                Share your honest experience to help future guests choose their stay.
            </p>

            <form
                action="/homes/<%= home._id %>/reviews"
                method="POST"
            >
                <input
                    type="hidden"
                    name="bookingId"
                    value="<%= eligibleBooking._id %>"
                >

                <label class="review-label">
                    Your rating
                </label>

                <div class="review-stars-input">
                    <% for (let star = 1; star <= 5; star++) { %>
                        <input
                            type="radio"
                            id="review-star-<%= star %>"
                            name="rating"
                            value="<%= star %>"
                            required
                        >
                        <label
                            for="review-star-<%= star %>"
                            title="<%= star %> out of 5 stars"
                            aria-label="<%= star %> out of 5 stars"
                        >★</label>
                    <% } %>
                </div>

                <label class="review-label" for="review-comment">
                    Your review
                </label>

                <textarea
                    class="review-textarea"
                    id="review-comment"
                    name="comment"
                    minlength="10"
                    maxlength="1000"
                    required
                    placeholder="What did you enjoy? What should future guests know?"
                ></textarea>

                <button class="review-submit" type="submit">
                    Submit Review
                </button>
            </form>
        </div>
    <% } %>

    <% if (reviews && reviews.length > 0) { %>
        <div class="review-list">
            <% reviews.forEach((review) => { %>
                <article class="review-card">
                    <div class="review-card-header">
                        <div>
                            <div class="review-author">
                                <% if (review.user) { %>
                                    <%= [review.user.firstName, review.user.lastName]
                                        .filter(Boolean)
                                        .join(" ") || "Guest" %>
                                <% } else { %>
                                    Guest
                                <% } %>
                            </div>

                            <div class="review-date">
                                <%= new Date(review.createdAt).toLocaleDateString(
                                    "en-IN",
                                    {
                                        day: "numeric",
                                        month: "short",
                                        year: "numeric"
                                    }
                                ) %>
                            </div>
                        </div>

                        <div class="review-card-rating">
                            ★ <%= review.rating %> / 5
                        </div>
                    </div>

                    <p class="review-comment"><%= review.comment %></p>
                </article>
            <% }); %>
        </div>
    <% } else { %>
        <div class="reviews-empty">
            No reviews have been submitted for this property yet.
        </div>
    <% } %>

</section>

    </main>


</body>

</html>