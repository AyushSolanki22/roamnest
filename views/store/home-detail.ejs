.rules-icon,
.no-rules-icon {
    background: #f2e9df;
    color: #806247;
}

.image-rating-star {
    background: #f2e9df;
    color: #806247;
}

.rating-box {
    background: #f8f3e9;
    border-color: #e9d8b7;
    box-shadow: none;
}

.rating-number {
    color: #29251f;
}

.rating-label {
    color: #81776c;
}

.details-divider {
