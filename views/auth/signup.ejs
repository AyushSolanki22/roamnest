<%- include('../partials/head') %>
  </head>

  <body class="min-h-screen bg-[#f8f5f0] text-slate-800">
    <%- include('../partials/header') %>

    <div class="mx-auto max-w-2xl px-4 py-8 sm:px-6 lg:py-10">
      <div class="rounded-[18px] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <h1 class="mb-8 text-center text-4xl font-bold text-slate-900">Create Your Account</h1>

        <form action="/signup" method="POST" class="space-y-5">
          <%- include('../partials/errors') %>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="firstName" class="mb-2 block text-sm font-medium text-slate-700">First Name</label>
              <div class="flex items-center rounded-lg border border-slate-300 bg-[#fcfaf7] px-3 focus-within:border-[#806047] focus-within:ring-2 focus-within:ring-[#806047]/15">
                <span class="mr-2 text-slate-500">👤</span>
                <input
                  id="firstName"
                  class="w-full bg-transparent py-3 text-slate-800 outline-none placeholder:text-slate-400"
                  type="text"
                  name="firstName"
                  placeholder="John"
                  value="<%= oldInput.firstName %>"
                  required
                >
              </div>
            </div>

            <div>
              <label for="lastName" class="mb-2 block text-sm font-medium text-slate-700">Last Name</label>
              <div class="flex items-center rounded-lg border border-slate-300 bg-[#fcfaf7] px-3 focus-within:border-[#806047] focus-within:ring-2 focus-within:ring-[#806047]/15">
                <span class="mr-2 text-slate-500">👤</span>
                <input
                  id="lastName"
                  class="w-full bg-transparent py-3 text-slate-800 outline-none placeholder:text-slate-400"
                  type="text"
                  name="lastName"
                  value="<%= oldInput.lastName %>"
                  placeholder="Doe"
                >
              </div>
            </div>
          </div>

          <div>
            <label for="email" class="mb-2 block text-sm font-medium text-slate-700">Email Address</label>
            <div class="flex items-center rounded-lg border border-slate-300 bg-[#fcfaf7] px-3 focus-within:border-[#806047] focus-within:ring-2 focus-within:ring-[#806047]/15">
              <span class="mr-2 text-slate-500">✉</span>
              <input
                id="email"
                class="w-full bg-transparent py-3 text-slate-800 outline-none placeholder:text-slate-400"
                type="email"
                name="email"
                placeholder="your.email@example.com"
                value="<%= oldInput.email %>"
                required
              >
            </div>
          </div>

          <div>
            <label for="password" class="mb-2 block text-sm font-medium text-slate-700">Password</label>
            <div class="flex items-center rounded-lg border border-slate-300 bg-[#fcfaf7] px-3 focus-within:border-[#806047] focus-within:ring-2 focus-within:ring-[#806047]/15">
              <span class="mr-2 text-slate-500">🔒</span>
              <input
                id="password"
                class="w-full bg-transparent py-3 text-slate-800 outline-none placeholder:text-slate-400"
                type="password"
                name="password"
                placeholder="Enter Your Password"
                value="<%= oldInput.password %>"
                required
              >
            </div>
          </div>

          <div>
            <label for="confirmPassword" class="mb-2 block text-sm font-medium text-slate-700">Confirm Password</label>
            <div class="flex items-center rounded-lg border border-slate-300 bg-[#fcfaf7] px-3 focus-within:border-[#806047] focus-within:ring-2 focus-within:ring-[#806047]/15">
              <span class="mr-2 text-slate-500">🔒</span>
              <input
                id="confirmPassword"
                class="w-full bg-transparent py-3 text-slate-800 outline-none placeholder:text-slate-400"
                type="password"
                name="confirmPassword"
                placeholder="Confirm Your Password"
                required
              >
            </div>
          </div>

          <div class="rounded-xl border border-slate-200 bg-[#fcfaf7] p-3">
            <p class="mb-3 text-base font-medium text-slate-700">I want to register as:</p>
            <div class="flex items-center gap-6">
              <label class="flex cursor-pointer items-center gap-2 text-slate-700">
                <input class="h-4 w-4 accent-[#806047]" type="radio" name="userType" value="guest" id="guest" <%= oldInput.userType === 'guest' ? 'checked' : '' %>>
                <span>Guest</span>
              </label>

              <label class="flex cursor-pointer items-center gap-2 text-slate-700">
                <input class="h-4 w-4 accent-[#806047]" type="radio" name="userType" value="host" id="host" <%= oldInput.userType === 'host' ? 'checked' : '' %>>
                <span>Host</span>
              </label>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <input class="mt-1 h-4 w-4 accent-[#806047]" type="checkbox" name="terms" id="terms" required>
            <label for="terms" class="text-sm text-slate-700">
              I agree to the
              <a href="/terms" class="font-medium text-[#806047] hover:text-[#684b35] hover:underline">terms and conditions</a>
            </label>
          </div>

          <button
  type="submit"
  style="background-color: #806047; color: white;"
  class="flex w-full items-center justify-center rounded-xl px-4 py-3 text-lg font-bold shadow-md transition hover:opacity-90"
>
  <span class="mr-2">Register</span>
  <span aria-hidden="true">→</span>
</button> 

          <p class="text-center text-base text-slate-600">
            Already have an account?
            <a href="/login" class="font-semibold text-[#806047] hover:text-[#684b35] hover:underline">Log in</a>
          </p>
        </form>
      </div>
    </div>
  </body>
</html>