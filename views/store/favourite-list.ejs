
<%- include("../partials/head") %>
</head>

<body class="rn-body">
  <%- include("../partials/header") %>

  <main class="rn-page-shell rn-favourites-page">
    <section class="rn-page-intro rn-favourites-intro">
      <p class="rn-eyebrow">Your personal collection</p>
      <h1>Your <span>favourites.</span></h1>
      <p class="rn-intro-copy">
        The stays you've saved for your next getaway, all in one place.
      </p>
    </section>

    <section class="rn-results-section">
      <div class="rn-results-heading">
        <div>
          <p class="rn-eyebrow">Saved stays</p>
          <h2>Places you've fallen for</h2>
        </div>

        <p class="rn-result-count">
          <strong><%= favouriteHomes.length %></strong>
          <%= favouriteHomes.length === 1 ? "stay" : "stays" %>
        </p>
      </div>

      <% if (favouriteHomes.length === 0) { %>
        <div class="rn-empty-state rn-favourites-empty">
          <div class="rn-empty-icon" aria-hidden="true">♡</div>

          <h3>Your collection starts here</h3>

          <p>
            You haven't saved any stays yet. Explore Roamnest and keep the
            places you love close at hand.
          </p>

          <a href="/homes" class="rn-button rn-button-primary">
            Explore stays <span aria-hidden="true">→</span>
          </a>
        </div>
      <% } else { %>
        <div class="rn-property-grid rn-favourites-grid">
          <% favouriteHomes.forEach(home => { %>
            <article class="rn-property-card rn-favourite-card">
              <a
                href="/homes/<%= home._id %>"
                class="rn-property-image-link"
                aria-label="View <%= home.name %>"
              >
                <img
                  src="<%= home.photo %>"
                  alt="<%= home.name %>"
                  class="rn-property-image"
                  loading="lazy"
                />

                <span class="rn-image-tag">Saved stay</span>
              </a>

              <div class="rn-property-content">
                <div class="rn-property-title-row">
                  <div>
                    <p class="rn-property-location">
                      <span aria-hidden="true">⌖</span>
                      <%= home.location %>
                    </p>

                    <h3>
                      <a href="/homes/<%= home._id %>">
                        <%= home.name %>
                      </a>
                    </h3>
                  </div>

                  <span
                    class="rn-rating"
                    aria-label="Rating <%= home.rating %> out of 5"
                  >
                    ★ <%= Number(home.rating).toFixed(1) %>
                  </span>
                </div>

                <div class="rn-property-meta">
                  <span>Up to <%= home.maxGuests %> guests</span>
                  <span>·</span>
                  <span>Comfort-led stays</span>
                </div>

                <div class="rn-property-footer">
                  <p class="rn-price">
                    <strong>
                      ₹<%= Number(home.price).toLocaleString("en-IN") %>
                    </strong>
                    <span>/ night</span>
                  </p>

                  <a
                    href="/homes/<%= home._id %>"
                    class="rn-details-link"
                  >
                    View stay <span aria-hidden="true">↗</span>
                  </a>
                </div>

                <form
                  action="/delete-favourite/<%= home._id %>"
                  method="POST"
                  class="rn-remove-favourite-form"
                >
                  <button
                    type="submit"
                    class="rn-button rn-remove-favourite-button"
                    aria-label="Remove <%= home.name %> from favourites"
                  >
                    <span aria-hidden="true">♥</span>
                    <span>Remove from Favourites</span>
                  </button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
