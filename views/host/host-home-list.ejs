<%- include("../partials/head") %>
</head>

<body>

  <%- include("../partials/header") %>

  <main
    class="container mx-auto bg-white shadow-lg rounded-lg p-8 mt-10 max-w-6xl px-6"
  >

    <h2
      class="text-3xl text-red-500 font-bold text-center mb-6"
    >
      Hey Host! Here are your homes: 
    </h2>

    <% if (registeredHomes.length === 0) { %>
      <div class="text-center text-gray-600 mt-6">
        No homes registered yet.
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-8"">
        <% registeredHomes.forEach(home => { %>
          <div class="border rounded-3xl overflow-hidden shadow-lg hover:shadow-xl transition bg-white">
            <div class="h-64 overflow-hidden bg-gray-100">
              <img
                src="<%= home.photo %>"
                alt="<%= home.name %>"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between mb-3">
                <h3 class="text-2xl font-semibold text-slate-900">
                  <%= home.name %>
                </h3>
                <span class="inline-block bg-red-100 text-red-700 text-sm font-medium px-3 py-1 rounded-full">
                  <%= home.rating %> ★
                </span>
              </div>
              <p class="text-gray-600 mb-2">
                <span class="font-medium">Location:</span> <%= home.location %>
              </p>
              <p class="text-1.5xl   text-gray-600 mb-4"><b>
                <span class="font-medium"><b>Price:</b></span> <%= home.price %>/night</b>
              </p>
              <a href="/host/edit-home/<%=home._id%>?editing=true" class="bg-blue-500   p-2">Edit</a>
              <form action="/host/delete-home/<%= home._id %>" method="post">
                <button class="bg-red-500 p-2">Delete</button>
              </form>

            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  </main>

</body>
</html>