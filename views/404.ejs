 <%- include('partials/head') %>
</head>

<body class="min-h-screen bg-[#f8f5f0] text-gray-900">

  <%- include('partials/header') %>

  <main class="flex min-h-[75vh] items-center justify-center px-4 py-12">
    <section class="w-full max-w-xl rounded-2xl border border-[#e9dfd3] bg-white px-6 py-12 text-center shadow-[0_12px_40px_rgba(80,60,40,0.08)] sm:px-12">

      <div class="mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-2xl bg-[#f3ebe3] text-3xl font-bold text-[#806047]">
        r.
      </div>

      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.25em] text-[#806047]">
        Lost your way?
      </p>

      <h1 class="mb-3 text-7xl font-extrabold tracking-tight text-[#806047] sm:text-8xl">
        404
      </h1>

      <h2 class="mb-3 text-2xl font-semibold text-gray-900">
        Oops! Page not found
      </h2>

      <p class="mx-auto mb-8 max-w-sm text-base leading-7 text-gray-500">
        Looks like this page has checked out. Let's get you back to discovering your next stay.
      </p>

      <a
        href="/"
        class="inline-flex items-center justify-center rounded-full bg-[#806047] px-7 py-3 font-semibold text-white transition duration-200 hover:bg-[#684b35] focus:outline-none focus:ring-2 focus:ring-[#806047] focus:ring-offset-2"
      >
        Go back home
        <span class="ml-2" aria-hidden="true">&rarr;</span>
      </a>

    </section>
  </main>

</body>
</html>