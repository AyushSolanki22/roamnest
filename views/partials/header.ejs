<header class="rn-header">
  <nav class="rn-nav" aria-label="Main navigation">
    <div class="rn-nav-main">
      <a href="/" class="rn-brand" aria-label="Roamnest home"><span class="rn-brand-mark">r.</span><span>roamnest</span></a>
      <div class="rn-nav-links">
        <a href="/homes" class="rn-nav-link <%= currPage === 'Home' ? 'is-active' : '' %>">Explore stays</a>
        <% if (isLoggedIn && user && user.userType === 'guest') { %>
          <a href="/bookings" class="rn-nav-link <%= currPage === 'bookings' ? 'is-active' : '' %>">My bookings</a>
          <a href="/favourites" class="rn-nav-link <%= currPage === 'favourites' ? 'is-active' : '' %>">Favourites</a>
        <% } %>
        <% if (isLoggedIn && user && user.userType === 'host') { %>
          <a href="/host/host-homes" class="rn-nav-link <%= currPage === 'host-homes' ? 'is-active' : '' %>">Your homes</a>
          <a href="/host/add-home" class="rn-nav-link <%= currPage === 'addHome' ? 'is-active' : '' %>">Add a stay</a>
        <% } %>
      </div>
    </div>
    <div class="rn-nav-account">
      <% if (isLoggedIn) { %>
        <span class="rn-account-greeting">Hello<%= user && user.firstName ? ', ' + user.firstName : '' %></span>
        <form action="/logout" method="POST"><button type="submit" class="rn-button rn-button-outline">Log out</button></form>
      <% } else { %>
        <a href="/login" class="rn-nav-link">Log in</a>
        <a href="/signup" class="rn-button rn-button-primary rn-button-small">Join Roamnest</a>
      <% } %>
    </div>
  </nav>
</header>
