
<%- include("../partials/head") %>
</head>

<body class="rn-body">
  <%- include("../partials/header") %>

  <main class="rn-page-shell rn-host-homes">
    <header class="rn-page-intro rn-host-intro">
      <p class="rn-eyebrow">Your hosting space</p>
      <h1>Hey Host! <span>Your homes.</span></h1>
      <p class="rn-intro-copy">
        Keep your stays looking their best and manage your listings in one place.
      </p>
    </header>

    <div class="rn-host-toolbar">
      <div>
        <p class="rn-eyebrow">Property management</p>
        <h2>
          Your listings
          <span class="rn-host-count"><%= registeredHomes.length %></span>
        </h2>
      </div>

      <a href="/host/add-home" class="rn-button rn-button-primary">
        <span aria-hidden="true">＋</span>
        Add a stay
      </a>
    </div>

    <% if (registeredHomes.length === 0) { %>
      <section class="rn-empty-state rn-host-empty">
        <div class="rn-empty-icon" aria-hidden="true">⌂</div>

        <h3>Your hosting journey starts here</h3>

        <p>
          You haven’t listed a stay yet. Add your first property and help
          guests find their next getaway.
        </p>

        <a href="/host/add-home" class="rn-button rn-button-primary">
          Add your first stay
        </a>
      </section>
    <% } else { %>
      <section
        class="rn-host-property-grid"
        aria-label="Your listed properties"
      >
        <% registeredHomes.forEach(home => { %>
          <article class="rn-property-card rn-host-property-card">
            <div class="rn-host-image-wrap">
              <img
                src="<%= home.photo %>"
                alt="<%= home.name %>"
                class="rn-property-image"
                loading="lazy"
              />

              <span class="rn-image-tag">Your listing</span>
            </div>

            <div class="rn-property-content rn-host-property-content">
              <div class="rn-property-title-row">
                <div class="rn-host-title-group">
                  <h3><%= home.name %></h3>

                  <p class="rn-property-location">
                    <span>Location</span> · <%= home.location %>
                  </p>
                </div>

                <span
                  class="rn-rating"
                  aria-label="Rating <%= home.rating %> out of 5"
                >
                  <span aria-hidden="true">★</span>
                  <%= home.rating %>
                </span>
              </div>

              <div class="rn-host-price-row">
                <p class="rn-price">
                  <strong>
                    ₹<%= Number(home.price).toLocaleString('en-IN') %>
                  </strong>
                  <span>/ night</span>
                </p>

                <span class="rn-host-price-note">
                  Per stay, per night
                </span>
              </div>

              <div class="rn-host-card-actions">
                <a
                  href="/host/edit-home/<%= home._id %>?editing=true"
                  class="rn-button rn-button-primary rn-button-small"
                >
                  Edit listing
                </a>

                <form
                  action="/host/delete-home/<%= home._id %>"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to delete this listing? This action cannot be undone.');"
                >
                  <button
                    type="submit"
                    class="rn-button rn-button-danger rn-button-small"
                  >
                    Delete
                  </button>
                </form>
              </div>
            </div>
          </article>
        <% }) %>
      </section>
    <% } %>
  </main>
</body>
</html>
