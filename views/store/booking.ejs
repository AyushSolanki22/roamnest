<%- include('../partials/head') %>
</head>

<body class="bg-slate-50">
  <%- include('../partials/header') %>

  <main class="booking-page min-h-screen py-10">
    <div class="max-w-7xl mx-auto px-5 lg:px-8">
      <!-- Back to property -->
      <div class="mb-8">
        <a
          href="/homes/<%= home._id %>"
          class="inline-flex items-center gap-2 text-slate-600 hover:text-red-500 font-medium transition"
        >
          ← Back to property
        </a>
      </div>

      <!-- MAIN BOOKING CARD -->
      <div class="booking-card bg-white rounded-3xl shadow-xl border border-slate-200 p-6 lg:p-7">

        <% if (bookingError) { %>
          <div
            role="alert"
            aria-live="assertive"
            class="mb-6 rounded-xl border border-red-200 bg-red-50 px-5 py-4 text-red-700"
          >
            <p class="font-semibold">Unable to complete your booking</p>
            <p class="mt-1 text-sm"><%= bookingError %></p>
          </div>
        <% } %>

        <!-- LEFT = PROPERTY | RIGHT = BOOKING -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 xl:gap-10">

          <!-- LEFT SIDE: PROPERTY -->
          <div class="space-y-6">
            <!-- Property Image -->
            <div class="booking-image overflow-hidden rounded-2xl bg-slate-100 shadow-sm">
              <img
                src="<%= home.photo %>"
                alt="<%= home.name %>"
                class="w-full h-[420px] object-cover"
              >
            </div>

            <!-- Property Information -->
            <div class="px-1">
              <h2 class="text-3xl font-bold text-slate-900">
                <%= home.name %>
              </h2>

              <div class="flex items-center gap-2 mt-2 text-slate-600">
                <span class="text-red-500">📍</span>
                <span><%= home.location %></span>
              </div>

              <div class="flex items-center gap-2 mt-3">
                <span class="text-yellow-500 text-xl">★</span>
                <span class="font-semibold text-slate-800">
                  <%= home.rating %> / 5
                </span>
              </div>

              <% if (home.description) { %>
                <div class="mt-5 border-t border-slate-200 pt-5">
                  <h3 class="font-bold text-lg text-slate-900 mb-2">
                    About this property
                  </h3>
                  <p class="text-slate-600 leading-relaxed">
                    <%= home.description %>
                  </p>
                </div>
              <% } %>

              <!-- Price information -->
              <div class="mt-6 bg-red-50 border border-red-100 rounded-2xl p-5">
                <div class="flex items-center justify-between gap-4">
                  <div>
                    <p class="text-sm text-slate-500">Starting price</p>
                    <p class="text-2xl font-bold text-slate-900">
                      ₹<%= home.price %>
                    </p>
                  </div>
                  <div class="text-sm text-slate-500">per night</div>
                </div>

                <p class="text-sm text-slate-600 mt-3">
                  Base price includes up to
                  <strong>
                    <%= includedGuests %>
                    <%= Number(includedGuests) === 1 ? 'guest' : 'guests' %>
                  </strong>
                  per night.
                </p>

                <% if (Number(home.maxGuests) > Number(includedGuests)) { %>
                  <p class="text-sm text-slate-600 mt-1">
                    Additional guests:
                    <strong>
                      ₹<%= Number(home.extraGuestFee || 0).toLocaleString('en-IN') %>
                    </strong>
                    per guest, per night.
                  </p>
                <% } %>
              </div>
            </div>
          </div>

          <!-- RIGHT SIDE: BOOKING -->
          <div class="space-y-6">
            <div>
              <p class="text-red-500 font-semibold text-sm mb-1">
                Reserve your stay
              </p>
              <h1 class="text-3xl lg:text-4xl font-bold text-slate-900">
                Book this home
              </h1>
              <p class="text-slate-500 mt-2">
                Choose your dates and number of guests.
              </p>
            </div>

            <!-- Booking Form -->
            <form
              action="/book/<%= home._id %>"
              method="POST"
              id="bookingForm"
              class="space-y-6"
            >
              <!-- CHECK-IN -->
              <div>
                <label
                  for="checkIn"
                  class="block font-semibold text-slate-800 mb-2"
                >
                  Check-in
                </label>
                <input
                  type="date"
                  id="checkIn"
                  name="checkIn"
                  value="<%= selectedCheckIn || '' %>"
                  required
                  class="booking-input w-full"
                >
              </div>

              <!-- CHECK-OUT -->
              <div>
                <label
                  for="checkOut"
                  class="block font-semibold text-slate-800 mb-2"
                >
                  Check-out
                </label>
                <input
                  type="date"
                  id="checkOut"
                  name="checkOut"
                  value="<%= selectedCheckOut || '' %>"
                  required
                  class="booking-input w-full"
                >
                <p
                  id="availabilityMessage"
                  role="status"
                  aria-live="polite"
                  class="hidden text-sm mt-2"
                ></p>
              </div>

              <!-- GUESTS -->
              <div>
                <label
                  for="guests"
                  class="block font-semibold text-slate-800 mb-2"
                >
                  Number of guests
                </label>

                <input
                  type="number"
                  id="guests"
                  name="guests"
                  min="1"
                  max="<%= home.maxGuests %>"
                  step="1"
                  value="<%= selectedGuests || Math.min(1, Number(home.maxGuests)) %>"
                  required
                  class="booking-input w-full"
                >

                <p class="text-sm text-slate-500 mt-2">
                  Maximum <%= home.maxGuests %>
                  <%= Number(home.maxGuests) === 1 ? 'guest' : 'guests' %>.
                </p>

                <p class="text-sm text-slate-500 mt-1">
                  The base price covers
                  <%= includedGuests %>
                  <%= Number(includedGuests) === 1 ? 'guest' : 'guests' %>.
                  <% if (Number(home.maxGuests) > Number(includedGuests)) { %>
                    Each additional guest costs
                    ₹<%= Number(home.extraGuestFee || 0).toLocaleString('en-IN') %>
                    per night.
                  <% } else { %>
                    No additional guest fee applies within this property's capacity.
                  <% } %>
                </p>
              </div>

              <!-- PRICE SUMMARY -->
              <div class="price-summary bg-slate-50 border border-slate-200 rounded-2xl p-5">

                <div class="price-row flex items-center justify-between gap-4 mb-3">
                  <span class="text-slate-600">Price per night</span>
                  <span
                    id="pricePerNight"
                    class="font-semibold text-slate-900 whitespace-nowrap"
                  >
                    ₹<%= home.price %>
                  </span>
                </div>

                <div class="price-row flex items-center justify-between gap-4 mb-3">
                  <span class="text-slate-600">Guests included in base price</span>
                  <span
                    id="includedGuestsLabel"
                    class="font-semibold text-slate-900 whitespace-nowrap"
                  >
                    <%= includedGuests %>
                  </span>
                </div>

                <div class="price-row flex items-center justify-between gap-4 mb-3">
                  <span class="text-slate-600">Nights</span>
                  <span
                    id="numberOfNights"
                    class="font-semibold text-slate-900 whitespace-nowrap"
                  >0</span>
                </div>

                <div class="price-row flex items-center justify-between gap-4 mb-3">
                  <span class="text-slate-600">Base amount</span>
                  <span
                    id="stayPrice"
                    class="font-semibold text-slate-900 whitespace-nowrap"
                  >₹0</span>
                </div>

                <div class="price-row flex items-center justify-between gap-4 mb-3">
                  <span class="text-slate-600">Additional guests</span>
                  <span
                    id="extraGuestCount"
                    class="font-semibold text-slate-900 whitespace-nowrap"
                  >0</span>
                </div>

                <div class="price-row flex items-center justify-between gap-4 mb-3">
                  <span class="text-slate-600">Extra guest charges</span>
                  <span
                    id="extraGuestCharges"
                    class="font-semibold text-slate-900 whitespace-nowrap"
                  >₹0</span>
                </div>

                <div class="price-row flex items-center justify-between gap-4 mb-3">
                  <span class="text-slate-600">Extra guest fee / night</span>
                  <span
                    id="extraGuestRate"
                    class="font-semibold text-slate-900 whitespace-nowrap"
                  >
                    ₹<%= home.extraGuestFee || 0 %>
                  </span>
                </div>

                <div class="total-row flex items-center justify-between gap-4 border-t border-slate-200 pt-4 mt-4">
                  <span class="text-lg font-bold text-slate-900">Total Amount:</span>
                  <span
                    id="totalPrice"
                    class="text-2xl font-extrabold text-red-500 whitespace-nowrap"
                  >₹0</span>
                </div>
              </div>

              <!-- Client-side validation error -->
              <p
                id="dateError"
                role="alert"
                aria-live="polite"
                class="hidden text-sm font-medium text-red-600 bg-red-50 border border-red-100 rounded-xl px-4 py-3"
              ></p>

              <!-- CONFIRM BUTTON -->
              <button
                type="submit"
                id="confirmBookingBtn"
                class="confirm-btn w-full"
              >
                Confirm Booking
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- STYLING -->
  <style>
  
/* =========================================
   ROAMNEST — BOOKING PAGE BRAND STYLES
   Styling only: preserve all existing logic.
========================================= */

:root {
  --rn-cream: #F8F6F2;
  --rn-surface: #FFFFFF;
  --rn-brown: #806247;
  --rn-brown-dark: #634A35;
  --rn-brown-light: #E8E0D7;
  --rn-border: #E6DED5;
  --rn-text: #29251F;
  --rn-muted: #81776C;
  --rn-green-bg: #EAF3EC;
  --rn-green-text: #386747;
  --rn-red-bg: #F8EDE8;
  --rn-red-text: #9C5541;
  --rn-shadow: 0 18px 48px rgba(65, 47, 31, 0.08);
}

body {
  background: var(--rn-cream) !important;
  color: var(--rn-text);
}

.booking-page {
  color: var(--rn-text);
  background: transparent;
  min-height: 100vh;
  padding: 36px 0 56px;
}

.booking-page > .max-w-7xl {
  width: calc(100% - 48px);
  max-width: 1440px;
  margin: 0 auto;
  padding: 0;
}

.booking-page > .max-w-7xl > div:first-child {
  margin-bottom: 24px;
}

/* Main booking card */
.booking-card,
.booking-card * {
  box-sizing: border-box;
}

.booking-card {
  background: var(--rn-surface);
  padding: clamp(18px, 2.4vw, 36px);
  border: 1px solid var(--rn-border);
  border-radius: 24px;
  box-shadow: var(--rn-shadow);
  overflow: hidden;
}

.booking-card > .grid > div {
  min-width: 0;
  display: grid;
  align-content: start;
  gap: 24px;
}

.booking-card > .grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: clamp(24px, 3vw, 44px);
  align-items: start;
}

.booking-card > .grid > div > .space-y-6 {
  display: grid;
  gap: 20px;
}

.booking-card > .grid > div:last-child > form {
  display: grid;
  gap: 20px;
}

.booking-card > .grid > div:last-child > form > div {
  margin: 0;
}

/* Back navigation */
.booking-page > .max-w-7xl > div:first-child a {
  color: var(--rn-brown);
  text-decoration: none;
  transition: color 0.2s ease;
}

.booking-page > .max-w-7xl > div:first-child a:hover {
  color: var(--rn-brown-dark);
}

/* Property image */
.booking-image {
  background: var(--rn-brown-light);
  border-radius: 20px;
  box-shadow: 0 12px 28px rgba(65, 47, 31, 0.12);
  overflow: hidden;
}

.booking-image img {
  display: block;
  width: 100%;
  height: 400px;
  object-fit: cover;
  object-position: center;
  transition: transform 0.45s ease;
}

.booking-image:hover img {
  transform: scale(1.025);
}

/* Headings and property information */
.booking-card h1,
.booking-card h2,
.booking-card h3 {
  color: var(--rn-text);
  letter-spacing: -0.025em;
}

.booking-card .text-slate-900,
.booking-card .text-slate-800 {
  color: var(--rn-text) !important;
}

.booking-card .text-slate-600,
.booking-card .text-slate-500 {
  color: var(--rn-muted) !important;
}

/* Replace red and yellow accents with brand brown */
.booking-card .text-red-500,
.booking-card .text-yellow-500 {
  color: var(--rn-brown) !important;
}

.booking-card > .grid > div:first-child > div:last-child {
  padding: 1.25rem;
  border: 1px solid var(--rn-border);
  border-radius: 18px;
  background: var(--rn-surface);
}

.booking-card > .grid > div:last-child > div:first-child {
  padding: 0.25rem 0 1rem;
  border-bottom: 1px solid var(--rn-border);
}

/* Booking heading accent */
.booking-card > .grid > div:last-child > div:first-child > p:first-child {
  color: var(--rn-brown) !important;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

/* Starting price panel */
.booking-card > .grid > div:first-child > div:last-child > div:last-of-type {
  background: var(--rn-cream);
  border-color: var(--rn-border);
}

/* Form labels */
.booking-card > .grid > div:last-child > form > div > label {
  display: block;
  color: var(--rn-text);
  font-weight: 600;
  letter-spacing: 0.01em;
}

/* Date and guest inputs */
.booking-input {
  width: 100%;
  padding: 14px 16px;
  border: 1px solid #D8CEC2;
  border-radius: 14px;
  background: #FFFFFF;
  color: var(--rn-text);
  outline: none;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.booking-input:hover {
  border-color: #B8A48F;
}

.booking-input:focus {
  border-color: var(--rn-brown);
  box-shadow: 0 0 0 4px rgba(128, 98, 71, 0.13);
  background: #FFFFFF;
}

/* Price summary */
.price-summary {
  background: var(--rn-cream) !important;
  border: 1px solid var(--rn-border) !important;
  border-radius: 18px;
  box-shadow: 0 8px 24px rgba(65, 47, 31, 0.045);
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 24px;
  gap: 1rem;
  padding-bottom: 0.15rem;
}

.price-row > span:first-child {
  min-width: 0;
  color: var(--rn-muted);
}

.price-row > span:last-child {
  flex: 0 0 auto;
  text-align: right;
  white-space: nowrap;
  color: var(--rn-text);
}

.extra-charge {
  white-space: nowrap;
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 42px;
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid var(--rn-border) !important;
}

.total-row > span:first-child {
  color: var(--rn-text) !important;
}

.total-row #totalPrice {
  color: var(--rn-brown-dark) !important;
}

/* Booking error and date validation */
.booking-card [role="alert"] {
  border-color: #E6C9BC;
  background: var(--rn-red-bg);
  color: var(--rn-red-text);
  border-radius: 14px;
}

#dateError {
  border-color: #E6C9BC;
  background: var(--rn-red-bg);
  color: var(--rn-red-text);
}

#availabilityMessage.text-red-600 {
  color: var(--rn-red-text) !important;
}

#availabilityMessage.text-emerald-700 {
  color: var(--rn-green-text) !important;
}

/* Confirm booking button */
.confirm-btn {
  width: 100%;
  padding: 15px 20px;
  border: 1px solid var(--rn-brown);
  border-radius: 14px;
  background: var(--rn-brown);
  color: #FFFFFF;
  font-size: 17px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 8px 20px rgba(99, 74, 53, 0.18);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.confirm-btn:hover {
  background: var(--rn-brown-dark);
  border-color: var(--rn-brown-dark);
  transform: translateY(-1px);
  box-shadow: 0 12px 25px rgba(99, 74, 53, 0.23);
}

.confirm-btn:active {
  transform: translateY(0);
}

.confirm-btn:focus-visible {
  outline: 3px solid rgba(128, 98, 71, 0.28);
  outline-offset: 3px;
}

/* Responsive layout */
@media (min-width: 1024px) {
  .booking-card > .grid {
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  }
}

@media (max-width: 1023px) {
  .booking-image img {
    height: clamp(280px, 52vw, 350px);
  }
}

@media (max-width: 480px) {
  .booking-page > .max-w-7xl {
    width: calc(100% - 24px);
  }

  .price-summary {
    padding: 1rem;
  }

  .price-row {
    gap: 0.55rem;
  }

  .price-row > span:first-child {
    font-size: 0.8rem;
  }

  .booking-card > .grid > div:first-child > div:last-child {
    padding: 1rem;
  }

  .booking-card {
    border-radius: 18px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .booking-image img,
  .booking-input,
  .confirm-btn {
    transition: none;
  }
}
</style>

  <!-- LIVE PRICE CALCULATION -->
  <script>
    // Browser-side estimates follow the server's pricing rules.
    // The server remains authoritative and recalculates every booking price.

    function roundMoney(amount) {
      return Math.round((amount + Number.EPSILON) * 100) / 100;
    }

    function formatMoney(amount) {
      return "₹" + amount.toLocaleString("en-IN", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    // Parse YYYY-MM-DD as a local calendar date without UTC date shifting.
    function parseDateOnly(value) {
      if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) {
        return null;
      }

      const [year, month, day] = value.split("-").map(Number);
      const date = new Date(year, month - 1, day);

      if (
        date.getFullYear() !== year ||
        date.getMonth() !== month - 1 ||
        date.getDate() !== day
      ) {
        return null;
      }

      date.setHours(0, 0, 0, 0);
      return date;
    }

    function getLocalDateString(date) {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, "0");
      const day = String(date.getDate()).padStart(2, "0");
      return `${year}-${month}-${day}`;
    }

    function calculateNights(checkIn, checkOut) {
      const startDay = Date.UTC(
        checkIn.getFullYear(),
        checkIn.getMonth(),
        checkIn.getDate()
      );

      const endDay = Date.UTC(
        checkOut.getFullYear(),
        checkOut.getMonth(),
        checkOut.getDate()
      );

      return (endDay - startDay) / (1000 * 60 * 60 * 24);
    }

    const checkInInput = document.getElementById("checkIn");
    const checkOutInput = document.getElementById("checkOut");
    const guestsInput = document.getElementById("guests");
    const bookingForm = document.getElementById("bookingForm");

    const numberOfNightsElement = document.getElementById("numberOfNights");
    const stayPriceElement = document.getElementById("stayPrice");
    const extraGuestCountElement = document.getElementById("extraGuestCount");
    const extraGuestChargesElement = document.getElementById("extraGuestCharges");
    const totalPriceElement = document.getElementById("totalPrice");
    const dateErrorElement = document.getElementById("dateError");
    const pricePerNightElement = document.getElementById("pricePerNight");
    const extraGuestRateElement = document.getElementById("extraGuestRate");

    // Values supplied by the server from the selected Home.
    const pricePerNight = Number("<%= home.price %>");
    const maxGuests = Number("<%= home.maxGuests %>");
    const includedGuests = Number("<%= includedGuests %>");
    const extraGuestFee = Number("<%= home.extraGuestFee || 0 %>");

    const validGuestConfiguration =
      Number.isInteger(maxGuests) &&
      maxGuests >= 1 &&
      Number.isInteger(includedGuests) &&
      includedGuests >= 1 &&
      includedGuests <= maxGuests;

    const validPriceConfiguration =
      Number.isFinite(pricePerNight) &&
      pricePerNight >= 0 &&
      Number.isFinite(extraGuestFee) &&
      extraGuestFee >= 0;

    // Initialize rate labels before dates are selected.
    pricePerNightElement.textContent =
      Number.isFinite(pricePerNight) && pricePerNight >= 0
        ? formatMoney(pricePerNight)
        : "Unavailable";

    extraGuestRateElement.textContent =
      Number.isFinite(extraGuestFee) && extraGuestFee >= 0
        ? formatMoney(extraGuestFee)
        : "Unavailable";

    function resetCalculatedPrices() {
      numberOfNightsElement.textContent = "0";
      stayPriceElement.textContent = formatMoney(0);
      extraGuestCountElement.textContent = "0";
      extraGuestChargesElement.textContent = formatMoney(0);
      totalPriceElement.textContent = formatMoney(0);
    }

    function showPriceError(message) {
      dateErrorElement.textContent = message;
      dateErrorElement.classList.remove("hidden");
    }

    function clearPriceError() {
      dateErrorElement.textContent = "";
      dateErrorElement.classList.add("hidden");
    }

    // Set minimum dates using the local calendar date.
    const todayString = getLocalDateString(new Date());
    checkInInput.min = todayString;
    checkOutInput.min = todayString;

    // Preserve the server error when the page is loaded after a redirect.
    const hasServerBookingError = <%= bookingError ? "true" : "false" %>;

    const availabilityMessageElement =
      document.getElementById("availabilityMessage");

    // Server-supplied confirmed bookings, represented as YYYY-MM-DD ranges.
    const unavailableDateRanges =
      <%- JSON.stringify(unavailableDateRanges || []) %>;

    // Booking ranges use [check-in, check-out):
    // checkout on another booking's check-in date is allowed.
    function findDateConflict(checkIn, checkOut) {
      return unavailableDateRanges.some((range) => {
        const bookedCheckIn = parseDateOnly(range.checkIn);
        const bookedCheckOut = parseDateOnly(range.checkOut);

        return Boolean(
          bookedCheckIn &&
          bookedCheckOut &&
          checkIn < bookedCheckOut &&
          checkOut > bookedCheckIn
        );
      });
    }

    function showAvailabilityMessage(message, unavailable = false) {
      availabilityMessageElement.textContent = message;

      availabilityMessageElement.classList.remove(
        "hidden",
        "text-red-600",
        "text-emerald-700"
      );

      availabilityMessageElement.classList.add(
        unavailable ? "text-red-600" : "text-emerald-700"
      );
    }

    function clearAvailabilityMessage() {
      availabilityMessageElement.textContent = "";
      availabilityMessageElement.classList.add("hidden");

      availabilityMessageElement.classList.remove(
        "text-red-600",
        "text-emerald-700"
      );
    }

    function calculatePrice() {
      // Do not immediately hide the server's booking conflict message
      // just because the price estimate recalculates.
      if (!hasServerBookingError) {
        clearPriceError();
      }

      resetCalculatedPrices();

      const checkInValue = checkInInput.value;
      const checkOutValue = checkOutInput.value;
      const guestsValue = guestsInput.value;
      const guests = Number(guestsValue);

      if (!validGuestConfiguration) {
        showPriceError(
          "This property's guest configuration is invalid. Please contact the host."
        );
        return false;
      }

      if (!validPriceConfiguration) {
        showPriceError(
          "This property has invalid pricing. Please contact the host."
        );
        return false;
      }

      if (
        guestsValue === "" ||
        !Number.isInteger(guests) ||
        guests < 1 ||
        guests > maxGuests
      ) {
        showPriceError(
          `Please select a whole number of guests between 1 and ${maxGuests}.`
        );
        return false;
      }

      if (!checkInValue || !checkOutValue) {
        clearAvailabilityMessage();
        return false;
      }

      const checkIn = parseDateOnly(checkInValue);
      const checkOut = parseDateOnly(checkOutValue);
      const today = parseDateOnly(todayString);

      if (!checkIn || !checkOut || !today) {
        clearAvailabilityMessage();
        showPriceError("Please enter valid check-in and check-out dates.");
        return false;
      }

      if (checkIn < today) {
        clearAvailabilityMessage();
        showPriceError("Check-in date cannot be in the past.");
        return false;
      }

      checkOutInput.min = checkInValue;

      if (checkOut <= checkIn) {
        clearAvailabilityMessage();
        showPriceError("Check-out must be after check-in.");
        return false;
      }

      // Check selected dates against existing confirmed reservations.
      if (findDateConflict(checkIn, checkOut)) {
        showAvailabilityMessage(
          "These dates overlap an existing booking. Please choose different dates.",
          true
        );

        showPriceError(
          "These dates are unavailable for this property."
        );

        return false;
      }

      clearAvailabilityMessage();
      showAvailabilityMessage("These dates appear to be available.");

      const nights = calculateNights(checkIn, checkOut);

      if (!Number.isInteger(nights) || nights <= 0) {
        showPriceError("Please select a valid stay duration.");
        return false;
      }

      // Base amount = nightly base price × nights.
      const stayPrice = roundMoney(nights * pricePerNight);

      // Extra guests = guests beyond the included guest count.
      const extraGuests = Math.max(0, guests - includedGuests);

      // Extra guest charges = extra guests × fee per night × nights.
      const extraGuestCharges = roundMoney(
        extraGuests * extraGuestFee * nights
      );

      const total = roundMoney(stayPrice + extraGuestCharges);

      if (
        !Number.isFinite(stayPrice) ||
        !Number.isFinite(extraGuestCharges) ||
        !Number.isFinite(total)
      ) {
        showPriceError(
          "Unable to calculate the booking price. Please try again."
        );
        return false;
      }

      numberOfNightsElement.textContent = String(nights);
      stayPriceElement.textContent = formatMoney(stayPrice);
      extraGuestCountElement.textContent = String(extraGuests);
      extraGuestChargesElement.textContent = formatMoney(extraGuestCharges);
      totalPriceElement.textContent = formatMoney(total);

      return true;
    }

    checkInInput.addEventListener("input", calculatePrice);

    checkInInput.addEventListener("change", function () {
      if (checkInInput.value) {
        checkOutInput.min = checkInInput.value;

        if (
          checkOutInput.value &&
          checkOutInput.value <= checkInInput.value
        ) {
          checkOutInput.value = "";
        }
      } else {
        checkOutInput.min = todayString;
      }

      calculatePrice();
    });

    checkOutInput.addEventListener("input", calculatePrice);
    checkOutInput.addEventListener("change", calculatePrice);
    guestsInput.addEventListener("input", calculatePrice);
    guestsInput.addEventListener("change", calculatePrice);

    bookingForm.addEventListener("submit", function (event) {
      const isValidPriceAndStay = calculatePrice();

      if (!isValidPriceAndStay) {
        event.preventDefault();

        if (!validGuestConfiguration || !validPriceConfiguration) {
          return;
        }

        if (!checkInInput.value) {
          showPriceError("Please select a check-in date.");
          checkInInput.focus();
        } else if (!checkOutInput.value) {
          showPriceError("Please select a check-out date.");
          checkOutInput.focus();
        } else if (
          guestsInput.value === "" ||
          !Number.isInteger(Number(guestsInput.value)) ||
          Number(guestsInput.value) < 1 ||
          Number(guestsInput.value) > maxGuests
        ) {
          showPriceError(
            `Please select a whole number of guests between 1 and ${maxGuests}.`
          );
          guestsInput.focus();
        }
      }
    });

    // Initial calculation.
    calculatePrice();
  </script>
</body>
</html>